generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum CalculationMethod {
  FIXED
  EVENT_GUESTS
  QUANTITY
}

enum CustomerSelection {
  PENDING
  SELECTED
  NOT_SELECTED
}

enum ChangeRequestStatus {
  OPEN
  REVIEWED
  RESOLVED
  DECLINED
}

enum UserRole {
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)

  sessions RefreshSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshSession {
  id     String @id @default(uuid()) @db.Uuid
  token  String @unique
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique
  vendors Vendor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  description String?
  contactName String?
  phone       String?
  email       String?
  social      String?
  photos      String[] @default([])

  priceMin   Decimal? @db.Decimal(12, 2)
  priceMax   Decimal? @db.Decimal(12, 2)
  priceUnit  String?
  priceNotes String?

  isActive Boolean @default(true)

  proposalItems ProposalItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id       String  @id @default(uuid()) @db.Uuid
  fullName String
  phone    String
  email    String?
  notes    String?

  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingType {
  id                String            @id @default(uuid()) @db.Uuid
  name              String            @unique
  calculationMethod CalculationMethod
  isActive          Boolean           @default(true)

  proposalItems ProposalItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proposal {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  title      String
  eventType  String?
  eventDate  DateTime?
  location   String?
  guestCount Int?
  budget     Decimal?  @db.Decimal(12, 2)
  notes      String?

  status     ProposalStatus @default(DRAFT)
  validUntil DateTime?

  shareToken String? @unique @default(uuid())

  items          ProposalItem[]
  changeRequests ChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProposalItem {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @db.Uuid
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  vendorId String @db.Uuid
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  pricingTypeId String      @db.Uuid
  pricingType   PricingType @relation(fields: [pricingTypeId], references: [id], onDelete: Restrict)

  description String?

  unitPrice  Decimal @db.Decimal(12, 2)
  quantity   Decimal @default(1) @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  customerSelection CustomerSelection @default(PENDING)

  changeRequests ChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChangeRequest {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @db.Uuid
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  proposalItemId String?       @db.Uuid
  proposalItem   ProposalItem? @relation(fields: [proposalItemId], references: [id], onDelete: SetNull)

  message  String
  status   ChangeRequestStatus @default(OPEN)
  response String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
